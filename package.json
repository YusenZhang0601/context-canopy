{
  "name": "context-canopy",
  "version": "1.0.1",
  "description": "Portable, local-first personal AI context: switch agents without losing memory, identity, goals, rules, or evidence",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "npm run test:vault && npm run test:mcp",
    "test:vault": "cd vault && python3 90-System/scripts/compile_vault.py --check --format json && bash 90-System/scripts/lint_vault.sh",
    "test:mcp": "cd mcp && npm test",
    "compile": "cd vault && python3 90-System/scripts/compile_vault.py --check --format json",
    "compile:write": "cd vault && python3 90-System/scripts/compile_vault.py --write-derived --format json",
    "lint": "cd vault && bash 90-System/scripts/lint_vault.sh",
    "smoke": "cd mcp && SECOND_BRAIN_FULL_VAULT_PATH=../vault npm run test:stdio-full-vault"
  },
  "keywords": [
    "personal-ai",
    "agent-memory",
    "ai-memory",
    "second-brain",
    "local-first",
    "markdown",
    "knowledge-graph",
    "llm-wiki",
    "obsidian",
    "mcp",
    "model-context-protocol",
    "knowledge-management",
    "ai-agent",
    "multi-agent",
    "agent-portability",
    "cross-agent-memory",
    "context-engineering",
    "agent-skills",
    "self-hosted",
    "privacy-first"
  ],
  "author": "TonyRainforest <zhangyswx@163.com> (https://github.com/YusenZhang0601)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YusenZhang0601/context-canopy.git"
  },
  "bugs": {
    "url": "https://github.com/YusenZhang0601/context-canopy/issues"
  },
  "homepage": "https://github.com/YusenZhang0601/context-canopy#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
